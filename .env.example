# Kredensial LLM. WAJIB diisi lewat FastAPI Cloud secret env var saat deploy,
# JANGAN pernah dikomit dengan nilai asli.
ANTHROPIC_API_KEY=

# Model Claude yang dipakai untuk generasi jawaban.
# Default: claude-opus-4-8 (kualitas tertinggi). Untuk penghematan biaya pada
# beban tinggi, bisa diganti ke claude-sonnet-5.
LLM_MODEL=claude-opus-4-8
LLM_MAX_TOKENS=1024

# Model embedding untuk vektorisasi chunk (multilingual, cocok untuk Bahasa Indonesia).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Path ke dokumen knowledge base (relatif terhadap working directory).
KB_PATH=data/raw_docs/nusantaracare_panduan_operasional_internal_v2.md

# Parameter chunking.
MAX_CHUNK_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# Parameter retrieval. TOP_K=8 & threshold=0.30 dikalibrasi ulang setelah
# pengujian nyata menemukan bahwa TOP_K=5/threshold=0.35 kadang meleset
# menangkap chunk yang benar untuk query yang tidak memakai istilah literal
# dari dokumen (mis. "SLA" vs "wajib diakui" di dokumen) — lihat README
# bagian Keterbatasan.
TOP_K=8
SIMILARITY_THRESHOLD=0.30
HIGH_CONFIDENCE_THRESHOLD=0.55
